<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/explore_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            style="@style/TextAppearance.Guofeng.LargeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="20dp"
            android:paddingTop="4dp"
            android:paddingRight="20dp"
            android:paddingBottom="4dp"
            android:text="@string/nav_discover" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:background="@drawable/bg_guofeng_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingTop="4dp"
            android:paddingRight="8dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="10dp"
                android:text="@string/explore_source"
                android:textAppearance="@style/TextAppearance.Guofeng.Footnote" />

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/explore_source_spinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/explore_filter_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="12dp"
                android:paddingTop="8dp"
                android:paddingRight="12dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:id="@+id/explore_subject"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/bg_guofeng_card"
                    android:gravity="center_vertical"
                    android:minWidth="96dp"
                    android:orientation="vertical"
                    android:paddingLeft="12dp"
                    android:paddingTop="4dp"
                    android:paddingRight="4dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_subject"
                        android:textAppearance="@style/TextAppearance.Guofeng.Footnote" />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/explore_spinner_subject"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:dropDownWidth="200dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/explore_area"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/bg_guofeng_card"
                    android:gravity="center_vertical"
                    android:minWidth="96dp"
                    android:orientation="vertical"
                    android:paddingLeft="12dp"
                    android:paddingTop="4dp"
                    android:paddingRight="4dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_area"
                        android:textAppearance="@style/TextAppearance.Guofeng.Footnote" />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/explore_spinner_area"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:dropDownWidth="200dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/explore_reader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/bg_guofeng_card"
                    android:gravity="center_vertical"
                    android:minWidth="96dp"
                    android:orientation="vertical"
                    android:paddingLeft="12dp"
                    android:paddingTop="4dp"
                    android:paddingRight="4dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_reader"
                        android:textAppearance="@style/TextAppearance.Guofeng.Footnote" />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/explore_spinner_reader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:dropDownWidth="200dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/explore_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/bg_guofeng_card"
                    android:gravity="center_vertical"
                    android:minWidth="96dp"
                    android:orientation="vertical"
                    android:paddingLeft="12dp"
                    android:paddingTop="4dp"
                    android:paddingRight="4dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_year"
                        android:textAppearance="@style/TextAppearance.Guofeng.Footnote" />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/explore_spinner_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:dropDownWidth="200dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/explore_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/bg_guofeng_card"
                    android:gravity="center_vertical"
                    android:minWidth="96dp"
                    android:orientation="vertical"
                    android:paddingLeft="12dp"
                    android:paddingTop="4dp"
                    android:paddingRight="4dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_progress"
                        android:textAppearance="@style/TextAppearance.Guofeng.Footnote" />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/explore_spinner_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:dropDownWidth="200dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/explore_order"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_guofeng_card"
                    android:gravity="center_vertical"
                    android:minWidth="96dp"
                    android:orientation="vertical"
                    android:paddingLeft="12dp"
                    android:paddingTop="4dp"
                    android:paddingRight="4dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_order"
                        android:textAppearance="@style/TextAppearance.Guofeng.Footnote" />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/explore_spinner_order"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:dropDownWidth="200dp" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/explore_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingLeft="4dp"
                android:paddingTop="6dp"
                android:paddingRight="4dp" />

            <include layout="@layout/custom_progress_bar" />

            <LinearLayout
                android:id="@+id/explore_unsupported"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/explore_unsupported"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/explore_go_search"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/explore_go_search" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
