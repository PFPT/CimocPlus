<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/library_chip_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="4dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/library_chip_favorite"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/comic_tab_favorite"
            app:closeIconVisible="false" />

        <com.google.android.material.chip.Chip
            android:id="@+id/library_chip_history"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/comic_tab_history"
            app:closeIconVisible="false" />

        <com.google.android.material.chip.Chip
            android:id="@+id/library_chip_local"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/comic_tab_local"
            app:closeIconVisible="false" />

        <com.google.android.material.chip.Chip
            android:id="@+id/library_chip_download"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/comic_tab_download"
            app:closeIconVisible="false" />
    </com.google.android.material.chip.ChipGroup>

    <FrameLayout
        android:id="@+id/library_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
